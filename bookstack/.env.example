# BookStack API credentials
# Generate via BookStack Admin → API Tokens → Create Token
BOOKSTACK_URL=https://help.kecktech.net
BOOKSTACK_TOKEN_ID=your_token_id
BOOKSTACK_TOKEN_SECRET=your_token_secret
BOOKSTACK_RETRY_COUNT=3
BOOKSTACK_RATE_LIMIT_MS=150

# WikiJS PostgreSQL connection (temporarily expose port 5432 on wikijs-db)
PGHOST=localhost
PGPORT=5432
PGUSER=wikijs
PGPASSWORD=kecktech_secure
PGDATABASE=wikijs
