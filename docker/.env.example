# Kecktech Stack — Environment Variable Template
# Copy this file to .env and fill in all values.
# Generate secrets with: openssl rand -hex 32

# ── ZAMMAD (service desk — replaces FreeScout) ───────────────────────────────
# ZAMMAD_SECRET_KEY: generate with: openssl rand -hex 64
ZAMMAD_DB_PASS=
ZAMMAD_SECRET_KEY=
# ZAMMAD_API_TOKEN: create in Zammad UI after first login (Admin → API → Token Access)
ZAMMAD_API_TOKEN=

# ── WORDPRESS ────────────────────────────────────────────────────────────────
WP_DB_PASS=
WP_DB_ROOT_PASS=

# ── WIKIJS ───────────────────────────────────────────────────────────────────
WIKIJS_DB_PASS=

# ── CUSTOM WIKI (BookStack fallback) ─────────────────────────────────────────
CUSTOM_WIKI_DB_PASS=
CUSTOM_WIKI_API_TOKEN=

# ── MAILCOW ──────────────────────────────────────────────────────────────────
# Password for the admin@kecktech.net MAILBOX (Mailcow: Edit mailbox — used for SMTP AUTH).
# Not the same as the Mailcow web UI admin login unless you made them identical.
# Used by: Vaultwarden SMTP, Authelia notifier (default), n8n email nodes.
MAILCOW_ADMIN_PASS=
# Optional: override only for Authelia SMTP (otherwise same as MAILCOW_ADMIN_PASS).
AUTHELIA_NOTIFIER_SMTP_PASSWORD=

# ── LLDAP (SSO user directory) ───────────────────────────────────────────────
LLDAP_JWT_SECRET=
LLDAP_ADMIN_PASS=

# ── AUTHELIA (SSO gateway) ───────────────────────────────────────────────────
AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_KEY=

# ── N8N (workflow automation) ────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=
# N8N_DEFAULT_PASS: initial admin password for n8n web UI
N8N_DEFAULT_PASS=

# ── UMAMI (analytics) ───────────────────────────────────────────────────────
UMAMI_DB_PASS=
UMAMI_APP_SECRET=
# UMAMI_PASS: Umami admin account password; used by dashboard for internal API auth
UMAMI_PASS=

# ── VAULTWARDEN (secrets manager) ───────────────────────────────────────────
VAULTWARDEN_ADMIN_TOKEN=

# ── INTEGRATIONS ─────────────────────────────────────────────────────────────
# Stripe: configure in ERPNext → Accounting → Payment Gateway after account is ready
STRIPE_API_KEY=
# Twilio: set as n8n Variables (Settings → Variables) after account is ready
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_ALERT_NUMBER=+1XXXXXXXXXX
