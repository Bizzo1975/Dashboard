# Kecktech Stack — Environment Variable Template
# Copy this file to .env and fill in all values.
# Generate secrets with: openssl rand -hex 32

# ── FREESCOUT ────────────────────────────────────────────────────────────────
FREESCOUT_ADMIN_PASS=
FREESCOUT_DB_PASS=
FREESCOUT_DB_ROOT_PASS=

# ── WORDPRESS ────────────────────────────────────────────────────────────────
WP_DB_PASS=
WP_DB_ROOT_PASS=

# ── WIKIJS ───────────────────────────────────────────────────────────────────
WIKIJS_DB_PASS=

# ── MAILCOW ──────────────────────────────────────────────────────────────────
# admin@kecktech.net mailbox password — must match the password set in Mailcow.
# Used by: Vaultwarden SMTP, Authelia SMTP notifier, n8n email nodes.
MAILCOW_ADMIN_PASS=

# ── LLDAP (SSO user directory) ───────────────────────────────────────────────
LLDAP_JWT_SECRET=
LLDAP_ADMIN_PASS=

# ── AUTHELIA (SSO gateway) ───────────────────────────────────────────────────
AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_KEY=

# ── N8N (workflow automation) ────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=

# ── UMAMI (analytics) ───────────────────────────────────────────────────────
UMAMI_DB_PASS=
UMAMI_APP_SECRET=

# ── VAULTWARDEN (secrets manager) ───────────────────────────────────────────
VAULTWARDEN_ADMIN_TOKEN=
