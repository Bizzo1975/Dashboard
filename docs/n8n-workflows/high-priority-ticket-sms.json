{
  "name": "High-Priority Ticket → SMS",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "freescout-ticket",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "id": "webhook-trigger",
      "name": "FreeScout Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "priority-high",
              "leftValue": "={{ $json.body.ticket.priority }}",
              "rightValue": "high",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "priority-urgent",
              "leftValue": "={{ $json.body.ticket.priority }}",
              "rightValue": "urgent",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        }
      },
      "id": "if-priority",
      "name": "Is High/Urgent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "from": "={{ $env.TWILIO_FROM_NUMBER }}",
        "to": "={{ $env.TWILIO_ALERT_NUMBER }}",
        "body": "=Kecktech Alert: High-priority ticket #{{ $json.body.ticket.id }} — {{ $json.body.ticket.subject }}\n\nCustomer: {{ $json.body.ticket.customer.email }}\nMailbox: {{ $json.body.ticket.mailbox }}\n\nView: https://helpdesk.kecktech.net/conversation/{{ $json.body.ticket.id }}"
      },
      "id": "twilio-sms",
      "name": "Send SMS Alert",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [750, 200],
      "credentials": {
        "twilioApi": {
          "id": "REPLACE_WITH_TWILIO_CREDENTIAL_ID",
          "name": "Kecktech Twilio"
        }
      }
    },
    {
      "parameters": {},
      "id": "no-op",
      "name": "Not High Priority",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [750, 400]
    }
  ],
  "connections": {
    "FreeScout Webhook": {
      "main": [
        [
          {
            "node": "Is High/Urgent?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is High/Urgent?": {
      "main": [
        [
          {
            "node": "Send SMS Alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Not High Priority",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "kecktech",
      "id": "1"
    }
  ],
  "meta": {
    "notes": "Import this workflow into n8n. Prerequisites: 1) Create Twilio credentials in n8n Settings → Credentials. 2) Set environment variables TWILIO_FROM_NUMBER and TWILIO_ALERT_NUMBER (Florida contact) in n8n Settings → Variables, OR replace the expressions in the Twilio node with literal values. 3) Activate the workflow. 4) Copy the webhook URL and paste into FreeScout → Manage → Mailboxes → Support → Webhooks."
  }
}
