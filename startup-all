#!/usr/bin/env bash
# =============================================================================
# Kecktech Stack — Master Startup Script
# Run from: /home/vboxuser/Dashboard
# Starts all Docker stacks in dependency order.
# =============================================================================
set -e
ROOT="$(cd "$(dirname "$0")" && pwd)"

echo "=== [1/5] Website dist build (website/dist) ==="
cd "$ROOT/website"
npm run build

echo ""
echo "=== [2/5] Mailcow (before main stack — Authelia needs SMTP on mail.kecktech.net:587) ==="
cd "$ROOT/mailcow"
docker compose up -d

echo ""
echo "=== [3/5] Main stack (Traefik, Authelia, LLDAP, FreeScout, Vaultwarden,"
echo "         n8n, WordPress, WikiJS, Umami, RustDesk, Heimdall, Portainer) ==="
cd "$ROOT/docker"
docker compose up -d

echo ""
echo "=== [4/5] Tactical RMM ==="
cd "$ROOT/tactical"
docker compose up -d

echo ""
echo "=== [5/5] ERPNext ==="
cd "$ROOT"
bash "$ROOT/startup-erpnext.sh" || echo "[WARN] ERPNext start failed — check ops.kecktech.net"

echo ""
echo "============================================================"
echo " All stacks started."
echo " Main:     https://dashboard.kecktech.net"
echo " Mail:     https://mail.kecktech.net  (admin / moohoo)"
echo " RMM:      https://rmm.kecktech.net   (admin)"
echo " ERPNext:  http://ops.kecktech.net:8080"
echo " Traefik:  https://traefik.kecktech.net"
echo "============================================================"
