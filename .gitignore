# ── Secrets (never commit) ────────────────────────────────────────────────────
docker/.env
erpnext/frappe_docker/.env
tactical/.env
mailcow/mailcow.conf
mailcow/.env

# ── Local HTTPS certs (mkcert / manual PEMs — see docs/HTTPS-TEST-ENV.md) ───
docker/traefik/certs-local/*.pem
docker/traefik/certs-local/*.key
# Active mkcert TLS snippet (generated by scripts/setup-mkcert-traefik.ps1)
docker/traefik/dynamic/tls-mkcert.yml

# ── Bind-mounted app data ────────────────────────────────────────────────────
docker/data/
mailcow/data/
backups/

# ── Authelia runtime data ────────────────────────────────────────────────────
docker/authelia/db.sqlite3
docker/authelia/notifications.txt

# ── Node / Next.js ───────────────────────────────────────────────────────────
dashboard/node_modules/
dashboard/.next/

# ── Claude IDE local settings ────────────────────────────────────────────────
.claude/

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
